{
  "name": "proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Proxy: the undo layer for AI agents. MCP server built with mcp-use.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "mcp-use dev --entry src/server.ts --views-dir src/app",
    "build": "mcp-use build --entry src/server.ts --views-dir src/app",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck --entry src/server.ts",
    "test": "vitest run",
    "check-env": "node --no-warnings --env-file-if-exists=.env scripts/check-env.ts",
    "demo:reset": "tsx --env-file-if-exists=.env src/agent/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "mcp-use": "2.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
