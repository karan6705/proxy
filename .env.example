# Stripe (test mode only): secret key starts with sk_test_, webhook secret with whsec_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic: LLM extraction fallback and the live-agent eval
ANTHROPIC_API_KEY=

# Inkbox: identity, email, SMS, iMessage, phone, A2A
INKBOX_API_KEY=
# Inkbox webhook signing key for Proxy's identity (verifies /inkbox/inbound, /inkbox/text, /inkbox/imessage)
INKBOX_WEBHOOK_SECRET=
# Public URL of this server (the tunnel or deployed host, no path). New task inboxes subscribe to it automatically.
INKBOX_PUBLIC_URL=
# Shared secret Inkbox sends as a bearer token with every webhook; created by src/inkbox/subscribe-cli.ts
INKBOX_WEBHOOK_TOKEN=
# 1 logs texts, calls and emails instead of sending them; also accepts unsigned webhooks
INKBOX_DRY_RUN=
# Proxy's own Inkbox handle (default proxy-agent) and, optionally, its agent-scoped key for A2A
INKBOX_PROXY_HANDLE=
INKBOX_PROXY_API_KEY=
# Merchant identities used only by the end-to-end demo
INKBOX_AIRLINE_API_KEY=
INKBOX_HOTEL_AGENT_API_KEY=
INKBOX_TRANSFER_SUPPORT_API_KEY=
# Unset uses test addresses; set to real only for end-to-end runs
MERCHANT_ADDRESS_MODE=
# The one human number allowed to reply UNDO ALL / PICK / KEEP (E.164, e.g. +14155550100)
HUMAN_PHONE=

# Supabase: server side only, never expose the service role key to a browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public MCP endpoint of the deployed server, e.g. https://<name>.manufact.app/mcp (local: http://localhost:3000/mcp)
MCP_URL=

# Scripted demo only: 1 enables the /demo/* routes and makes every task reuse INKBOX_DEMO_TASK_ID
PROXY_DEMO_ROUTES=

# Scripted demo only: the pre-created Inkbox identity every demo task reuses (default task_demo, i.e. task-demo@...)
INKBOX_DEMO_TASK_ID=
# Where the human is texted: imessage (default) or sms
HUMAN_ALERT_CHANNEL=
# Real ms to wait after the last captured action before texting about a new chain (default 1500)
PROXY_ALERT_SETTLE_MS=
# 1: the in-process mock merchant agent answers protocol messages; 0: always use Inkbox. Unset: loopback unless a real Inkbox key is set
PROXY_PROTOCOL_LOOPBACK=
# demo:hotel answers Proxy requests sent after this ISO time (default: the last 30 minutes)
HOTEL_AGENT_SINCE=
# Real ms to wait for a merchant agent before following up by email (demo default 60000)
PROXY_AGENT_TIMEOUT_MS=
